# Anthropic Claude API キー（チャットボット用）
# console.anthropic.com → API Keys → Create Key で発行
# 「sk-ant-」で始まる文字列を貼り付けてください
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# チャットログ記録用 Google Apps Script Webhook URL（任意）
# 未設定の場合はログ記録をスキップします（チャットボット本体には影響なし）
# 設定方法：以下の Google Apps Script を使ってスプレッドシートに自動記録できます
CHAT_LOG_WEBHOOK_URL=https://script.google.com/macros/s/your-script-id/exec
